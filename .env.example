# Copy this file to .env and fill in your own values to run in Azure Mode.
# Leave any of these blank (or don't create .env at all) to run in Demo Mode
# with the local MockAIProvider instead -- the app will still start and work.

# --- Azure OpenAI (required for AI-generated questions/evaluation) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Speech (optional, enables the voice mode: mic answers + spoken questions) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
